{
  "openapi": "3.1.0",
  "info": {
    "title": "RIGA v9 PRO SNIPER",
    "version": "9.0.0"
  },
  "servers": [
    {
      "url": "https://two7-hqhd.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Check backend health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },

    "/spot": {
      "get": {
        "operationId": "getSpotPrice",
        "summary": "Get spot price",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["NIFTY", "BANKNIFTY", "FINNIFTY", "SENSEX"]
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Spot response"
          }
        }
      }
    },

    "/option-chain": {
      "get": {
        "operationId": "getOptionChain",
        "summary": "Get option chain",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["NIFTY", "BANKNIFTY", "FINNIFTY", "SENSEX"]
            }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Option chain response"
          }
        }
      }
    },

    "/scan-options": {
      "get": {
        "operationId": "scanOptions",
        "summary": "Scan one index for sniper trades",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["NIFTY", "BANKNIFTY", "FINNIFTY", "SENSEX"]
            }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan result"
          }
        }
      }
    },

    "/scan-all-options": {
      "get": {
        "operationId": "scanAllMarkets",
        "summary": "Scan full market",
        "parameters": [
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full market scan"
          }
        }
      }
    }
  }
}

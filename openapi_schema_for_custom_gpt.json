{
  "openapi": "3.1.0",
  "info": {
    "title": "RIGA AI Option Buying Scanner",
    "version": "11.1.0",
    "description": "RIGA AI option buying scanner. Bullish setup returns BUY CE, bearish setup returns BUY PE, otherwise NO TRADE."
  },
  "servers": [
    {
      "url": "https://two7-hqhd.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Check backend health",
        "responses": {
          "200": {
            "description": "Backend health response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "server_time": {
                      "type": "string"
                    },
                    "market_session": {
                      "type": "object"
                    },
                    "routes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quickScan": {
      "get": {
        "operationId": "quickScan",
        "summary": "Quick final market scan",
        "description": "Returns compact final RIGA scan output with stable JSON structure. Best endpoint for ChatGPT direct scan.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "FIVE_MINUTE",
              "enum": [
                "ONE_MINUTE",
                "THREE_MINUTE",
                "FIVE_MINUTE",
                "TEN_MINUTE",
                "FIFTEEN_MINUTE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compact final scan result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "trade_available": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": "string"
                    },
                    "bias": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "option_trade": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "index": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "symbol": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "strike": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "option_type": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "expiry": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "entry": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "sl": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "targets": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "confidence": {
                      "type": "number"
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quickScanText": {
      "get": {
        "operationId": "quickScanText",
        "summary": "Quick final market scan in text format",
        "description": "Returns compact human-readable scan result.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Text scan result",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/spot": {
      "get": {
        "operationId": "getSpotPrice",
        "summary": "Get spot price",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "NIFTY",
                "BANKNIFTY",
                "FINNIFTY",
                "SENSEX"
              ]
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Spot response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "exchange": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "ltp": {
                      "type": "number"
                    },
                    "open": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    },
                    "low": {
                      "type": "number"
                    },
                    "close": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/option-chain": {
      "get": {
        "operationId": "getOptionChain",
        "summary": "Get option chain",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "NIFTY",
                "BANKNIFTY",
                "FINNIFTY",
                "SENSEX"
              ]
            }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "include_premium",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Option chain response"
          }
        }
      }
    },
    "/scan-options": {
      "get": {
        "operationId": "scanOptions",
        "summary": "Scan one index for option-buying setup",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "NIFTY",
                "BANKNIFTY",
                "FINNIFTY",
                "SENSEX"
              ]
            }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "FIVE_MINUTE"
            }
          },
          {
            "name": "debug",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single index scan result"
          }
        }
      }
    },
    "/scan-all-options": {
      "get": {
        "operationId": "scanAllMarkets",
        "summary": "Scan full market",
        "parameters": [
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "FIVE_MINUTE"
            }
          },
          {
            "name": "debug",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full market scan"
          }
        }
      }
    }
  }
}

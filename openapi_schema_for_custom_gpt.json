{
  "openapi": "3.1.0",
  "info": {
    "title": "RIGA REAL v5",
    "version": "5.0.0"
  },
  "servers": [
    {
      "url": "https://two7-hqhd.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Check health",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/ltp": {
      "get": {
        "operationId": "getLtp",
        "summary": "Get LTP",
        "parameters": [
          { "name": "exchange", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "tradingsymbol", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "symboltoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "LTP response" }
        }
      }
    },
    "/real-riga-signal": {
      "get": {
        "operationId": "getRealRigaSignal",
        "summary": "Get REAL RIGA signal",
        "parameters": [
          { "name": "exchange", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "tradingsymbol", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "symboltoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "REAL RIGA signal" }
        }
      }
    },
    "/real-riga-scan": {
      "get": {
        "operationId": "realRigaScan",
        "summary": "Scan default watchlist with REAL RIGA",
        "responses": {
          "200": { "description": "REAL RIGA scan result" }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}

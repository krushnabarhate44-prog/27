{
  "openapi": "3.1.0",
  "info": {
    "title": "RIGA AI Option Buying Scanner",
    "version": "11.2.0",
    "description": "RIGA AI compact option-buying scanner with market premium table. Bullish setup returns BUY CE, bearish setup returns BUY PE, otherwise NO TRADE."
  },
  "servers": [
    {
      "url": "https://two7-hqhd.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Check backend health",
        "responses": {
          "200": {
            "description": "Backend health response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "server_time": { "type": "string" },
                    "market_session": { "type": "object" },
                    "routes": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quickScan": {
      "get": {
        "operationId": "quickScan",
        "summary": "Quick final market scan",
        "description": "Returns compact final RIGA scan output with stable JSON structure. Use this for all direct market scan requests.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "FIVE_MINUTE",
              "enum": [
                "ONE_MINUTE",
                "THREE_MINUTE",
                "FIVE_MINUTE",
                "TEN_MINUTE",
                "FIFTEEN_MINUTE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compact final scan result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "version": { "type": "string" },
                    "trade_available": { "type": "boolean" },
                    "result": { "type": "string" },
                    "bias": { "type": ["string", "null"] },
                    "option_trade": { "type": ["string", "null"] },
                    "index": { "type": ["string", "null"] },
                    "symbol": { "type": ["string", "null"] },
                    "strike": { "type": ["integer", "null"] },
                    "option_type": { "type": ["string", "null"] },
                    "expiry": { "type": ["string", "null"] },
                    "entry": { "type": ["number", "null"] },
                    "sl": { "type": ["number", "null"] },
                    "targets": { "type": ["object", "null"] },
                    "confidence": { "type": "number" },
                    "reason": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/marketPremiums": {
      "get": {
        "operationId": "marketPremiums",
        "summary": "Get market index ATM option premiums",
        "description": "Returns spot, ATM strike, ATM CE/PE premiums and nearby option premiums for NIFTY, BANKNIFTY, FINNIFTY and SENSEX.",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "NIFTY",
                "BANKNIFTY",
                "FINNIFTY",
                "SENSEX"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "strikes_around",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Market premium table",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "version": { "type": "string" },
                    "checked_at": { "type": "string" },
                    "markets": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string" },
                          "index": { "type": "string" },
                          "spot_ltp": { "type": ["number", "null"] },
                          "spot_close": { "type": ["number", "null"] },
                          "atm": { "type": ["integer", "null"] },
                          "nearest_expiry": { "type": ["string", "null"] },
                          "atm_ce": { "type": ["object", "null"] },
                          "atm_pe": { "type": ["object", "null"] },
                          "options": {
                            "type": "array",
                            "items": { "type": "object" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/spot": {
      "get": {
        "operationId": "getSpotPrice",
        "summary": "Get spot price",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "NIFTY",
                "BANKNIFTY",
                "FINNIFTY",
                "SENSEX"
              ]
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Spot response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "symbol": { "type": "string" },
                    "exchange": { "type": "string" },
                    "token": { "type": "string" },
                    "ltp": { "type": "number" },
                    "open": { "type": "number" },
                    "high": { "type": "number" },
                    "low": { "type": "number" },
                    "close": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

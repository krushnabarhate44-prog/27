{
  "openapi": "3.1.0",
  "info": {
    "title": "RIGA Real Scanner Backend",
    "version": "3.1.0"
  },
  "servers": [
    {
      "url": "https://YOUR-RENDER-URL.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Check health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/ltp": {
      "get": {
        "operationId": "getLtp",
        "summary": "Get LTP",
        "parameters": [
          {
            "name": "exchange",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tradingsymbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "symboltoken",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "LTP"
          }
        }
      }
    },
    "/riga-signal-demo": {
      "get": {
        "operationId": "getRigaSignalDemo",
        "summary": "Get RIGA watch signal",
        "parameters": [
          {
            "name": "exchange",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tradingsymbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "symboltoken",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signal"
          }
        }
      }
    },
    "/scan-default-watchlist": {
      "get": {
        "operationId": "scanDefaultWatchlist",
        "summary": "Scan default watchlist",
        "responses": {
          "200": {
            "description": "Scan"
          }
        }
      }
    },
    "/scan-custom-watchlist": {
      "post": {
        "operationId": "scanCustomWatchlist",
        "summary": "Scan custom watchlist",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "exchange": {
                      "type": "string"
                    },
                    "tradingsymbol": {
                      "type": "string"
                    },
                    "symboltoken": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "exchange",
                    "tradingsymbol",
                    "symboltoken"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scan"
          }
        }
      }
    },
    "/option-chain-status": {
      "get": {
        "operationId": "getOptionChainStatus",
        "summary": "Option chain status",
        "responses": {
          "200": {
            "description": "Status"
          }
        }
      }
    },
    "/auto-alert-info": {
      "get": {
        "operationId": "getAutoAlertInfo",
        "summary": "Auto alert info",
        "responses": {
          "200": {
            "description": "Info"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}